{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qhclothes-release-staging",
  "compatibility_date": "2026-02-21",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",
  "d1_databases": [{
    "binding": "DB",
    "database_name": "qhclothes-release-staging",
    "database_id": "03832596-0ded-4fea-993f-a9a65892d8b7",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{"binding": "PRODUCT_IMAGES", "bucket_name": "qhclothes-release-staging-images"}],
  "durable_objects": {"bindings": [{
    "name": "LIVE_CHAT_ROOM", "class_name": "LiveChatRoom", "script_name": "qhclothes-live-chat-staging"
  }]},
  "vars": {"PRODUCT_IMAGES_PUBLIC_BASE_URL": "", "CORS_ALLOWED_ORIGINS": "https://qhclothes-release-staging.pages.dev"},
  "env": {"preview": {
    "d1_databases": [], "r2_buckets": [], "durable_objects": {"bindings": []}
  }}
}
