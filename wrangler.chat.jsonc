{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qhclothes-live-chat",
  "main": "src/liveChatWorker.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "LIVE_CHAT_ROOM", "class_name": "LiveChatRoom" }]
  },
  "migrations": [{ "tag": "live_chat_room_v1", "new_sqlite_classes": ["LiveChatRoom"] }],
  "triggers": { "crons": ["17 18 * * *"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "fashion-store-production",
    "database_id": "a1edf97a-0041-438e-84b9-e2ed9e4f6295"
  }],
  "observability": { "enabled": true }
}
