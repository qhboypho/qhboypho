{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qhclothes-payment-reconciliation",
  "main": "src/paymentReconciliationWorker.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fashion-store-production",
      "database_id": "a1edf97a-0041-438e-84b9-e2ed9e4f6295",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
