{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qhclothes",
  "compatibility_date": "2026-02-21",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fashion-store-production",
      "database_id": "a1edf97a-0041-438e-84b9-e2ed9e4f6295",
      "preview_database_id": "a1edf97a-0041-438e-84b9-e2ed9e4f6295"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PRODUCT_IMAGES",
      "bucket_name": "qhclothes-product-images",
      "preview_bucket_name": "qhclothes-product-images-preview"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LIVE_CHAT_ROOM",
        "class_name": "LiveChatRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "live_chat_room_v1",
      "new_sqlite_classes": [
        "LiveChatRoom"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "17 18 * * *"
    ]
  },
  "vars": {
    "PRODUCT_IMAGES_PUBLIC_BASE_URL": ""
  }
}
